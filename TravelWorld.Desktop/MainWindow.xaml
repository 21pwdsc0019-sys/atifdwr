<Window x:Class="TravelWorld.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TravelWorld.Desktop.ViewModels"
        Title="Travel World – Remittance & Ledger" Height="720" Width="1200">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#1E293B" Grid.Column="0">
            <StackPanel Margin="12">
                <TextBlock Text="Travel World" Foreground="White" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Remittance & Ledger" Foreground="#CBD5F5" Margin="0,0,0,16" />

                <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}" Margin="0,0,0,8" />
                <Button Content="Customers" Command="{Binding ShowCustomersCommand}" Margin="0,0,0,8" />
                <Button Content="Orders" Command="{Binding ShowOrdersCommand}" Margin="0,0,0,8" />
                <Button Content="Ledger" Command="{Binding ShowLedgerCommand}" Margin="0,0,0,8" />
                <Button Content="Reports" Command="{Binding ShowReportsCommand}" Margin="0,0,0,8" />
                <Button Content="Settings" Command="{Binding ShowSettingsCommand}" Margin="0,0,0,8" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#F8FAFC">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>
</Window>
